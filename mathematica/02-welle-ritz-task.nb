Notebook[{
Cell["Abgesetzte Welle mit Ritz", "Title"],

Cell["Theorie der Finite-Elemente-Methode \[CenterDot] Vorlesung 2 \
\[CenterDot] \[CapitalUDoubleDot]bung", "Subtitle"],

Cell["Aufgabe", "Section"],

Cell["\<\
Dieselbe abgesetzte Stahlwelle wie in der \[CapitalUDoubleDot]bung \
\[OpenCurlyDoubleQuote]Abgesetzte Welle \[UDoubleDot]ber die Energie\
\[CloseCurlyDoubleQuote] soll jetzt mit dem Ritzschen Verfahren berechnet \
werden: mit einem einzigen Polynom f\[UDoubleDot]r die ganze Welle.\
\>", "Text"],

