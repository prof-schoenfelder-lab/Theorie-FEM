Notebook[{
Cell["Stab beidseitig eingespannt mit Ritz", "Title"],

Cell["Theorie der Finite-Elemente-Methode \[CenterDot] Vorlesung 2 \
\[CenterDot] \[CapitalUDoubleDot]bung", "Subtitle"],

Cell["Aufgabe", "Section"],

Cell["\<\
Ein Stab mit konstantem EA ist an beiden Enden eingespannt und \
tr\[ADoubleDot]gt in L\[ADoubleDot]ngsrichtung die Streckenlast q(x) = q0 x/L.\
\>", "Text"],

