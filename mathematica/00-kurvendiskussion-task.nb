Notebook[{
Cell["Kurvendiskussion", "Title"],

Cell["Theorie der Finite-Elemente-Methode \[CenterDot] Vorlesung 0 \
\[CenterDot] \[CapitalUDoubleDot]bung", "Subtitle"],

Cell["Aufgabe: Kurvendiskussion", "Section"],

Cell["\<\
Gegeben ist die Funktion f(x) = x\.b3 \[Minus] 6x\.b2 + 4x + 8. Bestimmen Sie
a) den Verlauf im Diagramm,
b) die Nullstellen,
c) die Extrema und
d) die Fl\[ADoubleDot]che zwischen der mittleren und der \
gr\[ODoubleDot]\[SZ]ten Nullstelle.\
\>", "Text"],

Cell["a) Funktion definieren und darstellen", "Subsection"],

Cell["Gesucht: Ausdruck fkt und Diagramm", "Text"],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{"Ihre", " ", "Eingabe"}], " ", "*)"}]], "Input"],

Cell["b) Nullstellen", "Subsection"],

Cell["Gesucht: alle reellen Nullstellen, exakt und numerisch", "Text"],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{"Ihre", " ", "Eingabe"}], " ", "*)"}]], "Input"],

Cell["c) Extrema", "Subsection"],

Cell["Notwendige Bedingung: erste Ableitung gleich null.", "Text"],

Cell["\<\
Gesucht: Lage und Funktionswerte der Extrema, Art \[UDoubleDot]ber die zweite \
Ableitung\
\>", "Text"],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{"Ihre", " ", "Eingabe"}], " ", "*)"}]], "Input"],

Cell["d) Fl\[ADoubleDot]che", "Subsection"],

Cell["Fl\[ADoubleDot]che zwischen der mittleren und der \
gr\[ODoubleDot]\[SZ]ten Nullstelle.", "Text"],

Cell["\<\
Gesucht: bestimmtes Integral (exakt und numerisch) und Diagramm mit gef\
\[UDoubleDot]llter Fl\[ADoubleDot]che\
\>", "Text"],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{"Ihre", " ", "Eingabe"}], " ", "*)"}]], "Input"]
},
