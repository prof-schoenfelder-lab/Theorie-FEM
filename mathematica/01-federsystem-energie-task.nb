Notebook[{
Cell["Federsystem \[UDoubleDot]ber die Energie", "Title"],

Cell["Theorie der Finite-Elemente-Methode \[CenterDot] Vorlesung 1 \
\[CenterDot] \[CapitalUDoubleDot]bung", "Subtitle"],

Cell["\<\
Aufgabe: Federsystem mit drei Freiheitsgraden \[UDoubleDot]ber das Minimum \
der potentiellen Energie\
\>", "Section"],

Cell["\<\
Dasselbe System wie in der \[CapitalUDoubleDot]bung zu Vorlesung 0: Drei \
horizontal verschiebliche, starre Balken sind \[UDoubleDot]ber vier Federn \
miteinander und mit der Wand verbunden. Die Balken 1 und 3 werden durch F und \
3F belastet.\
\>", "Text"],

