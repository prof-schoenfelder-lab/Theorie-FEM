Notebook[{
Cell["FEM: Konischer Zugstab mit zwei Elementen", "Title"],

Cell["Theorie der Finite-Elemente-Methode \[CenterDot] Vorlesung 3 \
\[CenterDot] \[CapitalUDoubleDot]bung", "Subtitle"],

Cell["Aufgabenstellung", "Section"],

Cell["\<\
Ein Stab mit linear ver\[ADoubleDot]nderlichem Querschnitt A(x) ist am linken \
Ende (x = 0) gelagert und am rechten Ende (x = L) mit der Zugkraft F belastet.\
\>", "Text"],

Cell["\<\
L\[ODoubleDot]sen Sie den Verschiebungsverlauf u(x) und den Spannungsverlauf \
\[Sigma](x) mit der Finite-Elemente-Methode. Verwenden Sie zwei lineare \
Stabelemente gleicher L\[ADoubleDot]nge und gehen Sie den Ablauf der FEM \
Schritt f\[UDoubleDot]r Schritt durch. Vergleichen Sie mit der exakten L\
\[ODoubleDot]sung.\
\>", "Text"],

Cell["\<\
Gegeben: E = 70000 MPa, L = 1000 mm, F = 5000 N, A0 = 100 mm\.b2, A1 = A0/5 = \
20 mm\.b2\
\>", "Text"],

Cell["Gegebene Gr\[ODoubleDot]\[SZ]en", "Section"],

Cell[BoxData[
 RowBox[{"data", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Em", "\[Rule]", "70000"}], ",", 
    RowBox[{"L", "\[Rule]", "1000"}], ",", 
    RowBox[{"F", "\[Rule]", "5000"}], ",", 
    RowBox[{"A0", "\[Rule]", "100"}], ",", 
    RowBox[{"A1", "\[Rule]", "20"}]}], "}"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"Ax", "=", 
  RowBox[{"A0", "-", 
   FractionBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{"A0", "-", "A1"}], ")"}], " ", "x"}], "L"]}]}]], "Input"],

Cell["Exakte L\[ODoubleDot]sung (Referenz)", "Section"],

Cell["\<\
Differentialgleichung des Normalkraftstabes (EA u')' = 0 mit u(0) = 0 und E \
A(L) u'(L) = F:\
\>", "Text"],

Cell[BoxData[
 RowBox[{"dgl", "=", 
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "x"], 
    RowBox[{"(", 
     RowBox[{"Em", " ", "Ax", " ", 
      RowBox[{
       SubscriptBox["\[PartialD]", "x"], 
       RowBox[{"u", "[", "x", "]"}]}]}], ")"}]}], "\[Equal]", 
   "0"}]}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rb", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"u", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
     RowBox[{
      RowBox[{"Em", " ", 
       RowBox[{"(", 
        RowBox[{"Ax", "/.", "\[VeryThinSpace]", 
         RowBox[{"x", "\[Rule]", "L"}]}], ")"}], " ", 
       RowBox[{
        SuperscriptBox["u", "\[Prime]",
         MultilineFunction->None], "[", "L", "]"}]}], "\[Equal]", "F"}]}], 
    "}"}]}], ";"}]], "Input"],

Cell[BoxData[
 RowBox[{"uex", "=", 
  RowBox[{
   RowBox[{"u", "[", "x", "]"}], "/.", "\[VeryThinSpace]", 
   RowBox[{"First", "[", 
    RowBox[{"DSolve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dgl", ",", 
         RowBox[{"Sequence", "@@", "rb"}]}], "}"}], "/.", "\[VeryThinSpace]", 
       "data"}], ",", 
      RowBox[{"u", "[", "x", "]"}], ",", "x"}], "]"}], "]"}]}]}]], "Input"],

Cell[BoxData[
 RowBox[{"sigex", "=", 
  RowBox[{
   RowBox[{"Em", " ", 
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], "uex"}]}], "/.", "\[VeryThinSpace]", 
   "data"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"N", "[", 
  RowBox[{"uex", "/.", "\[VeryThinSpace]", 
   RowBox[{"x", "\[Rule]", "1000"}]}], "]"}]], "Input"],

Cell["L\[ODoubleDot]sung mit der FEM", "Section"],

Cell["1 Elementtyp: Ansatzfunktionen und Elementsteifigkeitsmatrix", \
"Subsection"],

Cell["\<\
Lineares Stabelement mit den Elementfreiheitsgraden p1e (rechter Knoten) und \
p2e (linker Knoten). Leiten Sie die Elementsteifigkeitsmatrix aus der inneren \
potentiellen Energie her.\
\>", "Text"],

Cell["\<\
Gesucht: Ansatzfunktionen Ne, Ableitung dNe und Elementsteifigkeitsmatrix Ke\
\>", "Text"],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{"Ihre", " ", "Eingabe"}], " ", "*)"}]], "Input"],

Cell["2 Vernetzung: Elementl\[ADoubleDot]ngen und Querschnitte", "Subsection"],

Cell["\<\
Zwei Elemente gleicher L\[ADoubleDot]nge. Jedes Element erh\[ADoubleDot]lt \
die Querschnittsfl\[ADoubleDot]che in seiner Mitte.\
\>", "Text"],

Cell["Gesucht: Listen le und ae, Elementsteifigkeitsmatrizen K[e]", "Text"],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{"Ihre", " ", "Eingabe"}], " ", "*)"}]], "Input"],

Cell["3 Konnektivit\[ADoubleDot]t: Inzidenzmatrizen", "Subsection"],

Cell["\<\
Systemfreiheitsgrade p1, p2, p3 (von links nach rechts). Es gilt pe = \
\[CapitalLambda]e . psys.\
\>", "Text"],

Cell["Gesucht: Inzidenzmatrizen \[CapitalLambda][1] und \[CapitalLambda][2]", \
"Text"],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{"Ihre", " ", "Eingabe"}], " ", "*)"}]], "Input"],

Cell["4 Zusammenbau: Systemsteifigkeitsmatrix", "Subsection"],

Cell["Gesucht: Ksys als Summe \[CapitalLambda]e^T Ke \[CapitalLambda]e", \
"Text"],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{"Ihre", " ", "Eingabe"}], " ", "*)"}]], "Input"],

Cell["5 Gleichungssystem l\[ODoubleDot]sen", "Subsection"],

Cell["\<\
Randbedingung: p1 = 0 (Lager), dort wirkt die unbekannte Lagerkraft q1. Am \
rechten Ende greift F an.\
\>", "Text"],

Cell["Gesucht: psys, qsys und L\[ODoubleDot]sung des Gleichungssystems", \
"Text"],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{"Ihre", " ", "Eingabe"}], " ", "*)"}]], "Input"],

Cell["6 bis 8 Auswertung: Verschiebungen und Spannungen", "Subsection"],

Cell["\<\
Elementverschiebungen pe = \[CapitalLambda]e . psys, Verschiebungsverlauf ue \
= Ne . pe, Spannung \[Sigma]e = E Ne' . pe\
\>", "Text"],

Cell["\<\
Gesucht: Verschiebungsverlauf ufem und Spannungsverlauf sigfem, Diagramme mit \
Vergleich zur exakten L\[ODoubleDot]sung\
\>", "Text"],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{"Ihre", " ", "Eingabe"}], " ", "*)"}]], "Input"],

Cell["Vergleich", "Subsection"],

Cell["Relative Fehler am Stabende in Prozent:", "Text"],

Cell["\<\
Gesucht: Fehler der Verschiebung und der Spannung am Stabende. Wie viele \
Elemente br\[ADoubleDot]uchte man f\[UDoubleDot]r 5 % Genauigkeit der \
Spannung?\
\>", "Text"],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{"Ihre", " ", "Eingabe"}], " ", "*)"}]], "Input"]
},
FrontEndVersion->"13.1 for Mac OS X ARM (64-bit) (June 16, 2022)",
StyleDefinitions->"Default.nb"
]
